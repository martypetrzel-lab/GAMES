# PostgreSQL (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gameradar_cz?schema=public"

# CheapShark vyžaduje identifikující User-Agent. Kontakt je nepovinný a neveřejný.
CHEAPSHARK_USER_AGENT="GameRadarCZ/0.1 (+https://github.com/martypetrzel-lab/GAMES)"
CHEAPSHARK_CONTACT_EMAIL=""

# Výchozí hodnotu obvykle není potřeba měnit.
CNB_API_BASE_URL="https://api.cnb.cz/cnbapi"

# Ve Fázi 1 ponechte vypnuté. Žádný reklamní skript se nenačítá.
ADS_ENABLED="false"

# Povinné v produkci. Tajný náhodný řetězec (alespoň 32 znaků).
AUTH_SECRET=""
# Povinné v produkci pro bezpečné callback URL.
APP_BASE_URL="http://localhost:3000"
# Konzervativní pool pro jednu webovou repliku. Při více replikách zohledněte limit PostgreSQL.
DATABASE_POOL_MAX="5"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
READINESS_TIMEOUT_MS="2000"
# disabled | log | resend. Výchozí disabled nic neodesílá.
EMAIL_PROVIDER="disabled"
# Povinné jen pro Resend: ověřený odesílatel a tajný API klíč.
EMAIL_FROM=""
EMAIL_API_KEY=""
# Bezpečné limity samostatného alert workeru.
CRON_BATCH_SIZE="10"
ALERT_COOLDOWN_HOURS="24"
# Tajné a nepovinné; Steam synchronizace zatím není aktivní.
STEAM_API_KEY=""
CATALOG_SYNC_ENABLED="false"
CATALOG_SYNC_BATCH_SIZE="60"
CATALOG_MAX_PAGES_PER_RUN="5"
CATALOG_REQUEST_DELAY_MS="2000"
CATALOG_MAX_RUNTIME_MINUTES="10"
PRICE_REFRESH_BATCH_SIZE="25"
VERIFIED_STORES_ONLY="true"
